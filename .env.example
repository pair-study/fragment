DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DB_NAME"
WEB_APP_ORIGIN="http://localhost:3000"
API_PUBLIC_BASE_URL="http://localhost:3001/api"
JWT_ACCESS_SECRET="replace-with-local-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS="7"

# Web app
# Same-origin API proxy/path in production. Use an absolute URL for separate local API server if needed.
NEXT_PUBLIC_API_BASE_URL="/api"

# GitHub MCP Server
# https://github.com/settings/tokens → Fine-grained token
# 필요 권한: Contents (read), Pull requests (read/write), Issues (read/write), Metadata (read)
GITHUB_PERSONAL_ACCESS_TOKEN=""
