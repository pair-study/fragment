{
  "name": "fragment",
  "private": true,
  "packageManager": "pnpm@10.34.1",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm --filter @fragment/web dev",
    "dev:api": "pnpm --filter @fragment/database build && pnpm --filter @fragment/api dev",
    "dev:all": "pnpm --filter @fragment/database build && pnpm --parallel --filter @fragment/web --filter @fragment/api dev",
    "build": "pnpm --filter @fragment/web build",
    "build:api": "corepack pnpm --filter @fragment/api... build",
    "db:generate": "pnpm --filter @fragment/database db:generate",
    "db:migrate": "pnpm --filter @fragment/database db:migrate",
    "db:push": "pnpm --filter @fragment/database db:push",
    "db:studio": "pnpm --filter @fragment/database db:studio",
    "db:reset": "pnpm --filter @fragment/database db:reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test": "pnpm test:web && pnpm test:api",
    "test:api": "pnpm --filter @fragment/api test",
    "test:web": "pnpm --filter @fragment/web test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "husky": "^9.1.7",
    "prettier": "^3.8.4"
  }
}
