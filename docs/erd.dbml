// ================================================================
// 일감 (근무 플랫폼) — ERD
// dbdiagram.io 에 붙여넣어 바로 시각화 가능
// ================================================================


// ----------------------------------------------------------------
// Enums
// ----------------------------------------------------------------

Enum user_role {
  ADMIN   [note: '관리자 (이메일+비밀번호 인증)']
  WORKER  [note: '근로자 (소셜 로그인)']
}

Enum auth_provider {
  EMAIL   [note: '관리자 전용']
  KAKAO
  NAVER
}

Enum schedule_type {
  FIXED
  FLEXIBLE
}

Enum schedule_status {
  DRAFT      [note: 'AI 추천 초안 — 미확정']
  PUBLISHED  [note: '관리자 확정 — 근로자에게 노출']
  CANCELLED  [note: '교환·퇴사·패턴 변경으로 취소 (이력 보존)']
}

Enum member_status {
  ACTIVE
  RESIGNED
}

Enum availability_status {
  AVAILABLE        [note: '기본값 — 하루 전체 가능']
  UNAVAILABLE      [note: 'Hard constraint — AI 배정 제외']
  TIME_CONSTRAINED [note: 'Soft constraint — 특정 시간대만 가능']
}

Enum period_status {
  OPEN
  CLOSED
}

Enum attendance_status {
  EXPECTED    [note: '스케줄 PUBLISHED 시 자동 생성']
  PRESENT     [note: '출근 체크 완료']
  COMPLETED   [note: '퇴근 체크 완료']
  UNPROCESSED [note: '예정 퇴근 +12h 경과 시 자동 전환']
}

Enum adjust_type {
  CHECKIN
  CHECKOUT
  OVERTIME_END
}

Enum adjustment_request_status {
  PENDING
  APPROVED
  REJECTED
}

Enum exchange_status {
  PENDING_ACCEPTANCE [note: 'B의 수락 대기']
  PENDING_ADMIN      [note: '관리자 승인 대기']
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED            [note: '24h 미응답 자동 취소']
}

Enum payroll_status {
  CALCULATED [note: '계산 완료 — 발급 전']
  ISSUED     [note: '명세서 발급 완료']
}

Enum payroll_action {
  CALCULATED
  RECALCULATED [note: '근태 수정 후 재계산']
  ISSUED
}

Enum attendance_audit_action {
  ADMIN_MANUAL_ENTRY
  ADJUSTMENT_APPROVED
  ADJUSTMENT_REJECTED
}

Enum wage_type {
  HOURLY
  DAILY
}

Enum deduction_type {
  WITHHOLDING_3_3         [note: '3.3% 원천징수 (프리랜서)']
  INCOME_TAX_4_INSURANCE  [note: '소득세 + 4대보험']
  ALL_INSURANCE           [note: '4대보험 전체']
  EMPLOYMENT_ONLY         [note: '고용보험만']
}

Enum schedule_unit {
  WEEK_1
  WEEK_2
  WEEK_4
  CUSTOM
}

Enum day_of_week {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

Enum biweekly_week {
  ODD   [note: '홀수 주']
  EVEN  [note: '짝수 주']
}

Enum payroll_attendance_inclusion {
  INCLUDED    [note: '급여 계산에 포함된 근태']
  EXCLUDED    [note: 'UNPROCESSED 등으로 제외된 근태']
}


// ----------------------------------------------------------------
// FR-1. 계정 및 조직 관리
// ----------------------------------------------------------------

Table users {
  id            bigint        [pk, increment]
  name          varchar(50)   [not null]
  email         varchar(255)  [unique, null,  note: 'ADMIN 필수 / WORKER nullable']
  password_hash varchar(255)  [null,          note: 'provider=EMAIL 시만 사용']
  provider      auth_provider [not null]
  provider_id   varchar(255)  [null,          note: '소셜 로그인 플랫폼 고유 ID']
  role          user_role     [not null]
  deleted_at    timestamp     [null]
  created_at    timestamp     [not null, default: `now()`]
  updated_at    timestamp     [not null, default: `now()`]

  indexes {
    (provider, provider_id) [unique, name: 'uq_provider_identity',
      note: 'NULL provider_id(이메일 유저)는 유니크 제약 DB 레벨 처리 필요']
  }

  Note: '관리자(EMAIL)와 근로자(KAKAO/NAVER)를 단일 테이블로 관리. role로 분기.'
}

Table password_reset_tokens {
  id         bigint       [pk, increment]
  user_id    bigint       [not null, ref: > users.id]
  token      varchar(255) [unique, not null]
  expires_at timestamp    [not null, note: '발급 후 30분']
  used_at    timestamp    [null,     note: '1회 사용 후 무효화']
  created_at timestamp    [not null, default: `now()`]
  updated_at timestamp    [not null, default: `now()`]
}

Table organizations {
  id                           bigint        [pk, increment]
  owner_id                     bigint        [not null, ref: > users.id]
  business_number              varchar(20)   [not null, note: '국세청 API 검증. 다지점 중복 허용']
  name                         varchar(100)  [not null]
  address                      varchar(255)  [not null, note: '도로명주소 API로 선택']
  gps_lat                      decimal(10,7) [null]
  gps_lng                      decimal(10,7) [null]
  gps_radius_m                 int           [not null, default: 100, note: '50~300 범위']
  allow_schedule_exchange      boolean       [not null, default: false]
  public_holiday_exclude_fixed boolean       [not null, default: false,
    note: 'true = FIXED 스케줄 공휴일 자동 제외. org_public_holiday_exceptions로 예외 추가']
  schedule_unit                schedule_unit [null]
  schedule_deadline_days       int           [null, default: 7]
  schedule_adjust_days         int           [null, default: 2]
  schedule_auto_repeat         boolean       [null, default: false]
  deleted_at                   timestamp     [null]
  created_at                   timestamp     [not null, default: `now()`]
  updated_at                   timestamp     [not null, default: `now()`]

  Note: '관리자 1명이 여러 조직 소유 가능 (owner_id). 근로자는 organization_members로 연결.'
}

Table org_regular_holidays {
  id            bigint        [pk, increment]
  org_id        bigint        [not null, ref: > organizations.id]
  day_of_week   day_of_week   [not null]
  biweekly      boolean       [not null, default: false, note: 'false=매주, true=격주']
  biweekly_week biweekly_week [null, note: 'biweekly=true 시 홀수/짝수 주 지정']
  created_at    timestamp     [not null, default: `now()`]
  updated_at    timestamp     [not null, default: `now()`]
}

Table org_public_holiday_exceptions {
  id           bigint       [pk, increment]
  org_id       bigint       [not null, ref: > organizations.id]
  holiday_date date         [not null]
  is_included  boolean      [not null,
    note: 'true = 이 공휴일은 예외적으로 근무(자동제외 on 조직) / false = 이 날은 예외적으로 휴무(자동제외 off 조직)']
  note         varchar(255) [null]
  created_at   timestamp    [not null, default: `now()`]
  updated_at   timestamp    [not null, default: `now()`]

  indexes {
    (org_id, holiday_date) [unique]
  }
}

Table invite_links {
  id         bigint       [pk, increment]
  org_id     bigint       [not null, ref: > organizations.id]
  token      varchar(255) [unique, not null]
  created_by bigint       [not null, ref: > users.id, note: '링크를 생성한 관리자']
  expires_at timestamp    [not null, note: '생성 후 7일']
  revoked_at timestamp    [null,     note: '관리자가 수동 무효화한 시각']
  created_at timestamp    [not null, default: `now()`]
  updated_at timestamp    [not null, default: `now()`]
}


// ----------------------------------------------------------------
// FR-5. 인력 관리 (조직-근로자 연결 및 임금 템플릿)
// ----------------------------------------------------------------

Table wage_templates {
  id                         bigint         [pk, increment]
  org_id                     bigint         [not null, ref: > organizations.id]
  name                       varchar(100)   [not null]
  wage_type                  wage_type      [not null]
  base_wage                  decimal(12,2)  [not null, note: '시급(HOURLY) 또는 일급(DAILY)']
  weekly_holiday_pay_enabled boolean        [not null, default: true]
  overtime_enabled           boolean        [not null, default: false]
  overtime_rate              decimal(4,2)   [not null, default: 1.5]
  night_shift_enabled        boolean        [not null, default: false]
  night_shift_rate           decimal(4,2)   [not null, default: 1.5]
  night_shift_start          time           [not null, default: '22:00:00']
  night_shift_end            time           [not null, default: '06:00:00']
  holiday_pay_enabled        boolean        [not null, default: false]
  holiday_pay_rate           decimal(4,2)   [not null, default: 1.5]
  deduction_type             deduction_type [not null]
  deleted_at                 timestamp      [null]
  created_at                 timestamp      [not null, default: `now()`]
  updated_at                 timestamp      [not null, default: `now()`]

  Note: '조직에 등록된 템플릿. 근로자 등록 시 organization_members.wage_template_id로 지정.'
}

Table organization_members {
  id               bigint        [pk, increment]
  org_id           bigint        [not null, ref: > organizations.id]
  user_id          bigint        [not null, ref: > users.id]
  wage_template_id bigint        [null,     ref: > wage_templates.id,
    note: '근로자 등록 후 관리자가 필수 지정. null이면 급여 계산 차단']
  schedule_type    schedule_type [not null]
  status           member_status [not null, default: 'ACTIVE']
  joined_at        date          [not null]
  resigned_at      date          [null]
  created_at       timestamp     [not null, default: `now()`]
  updated_at       timestamp     [not null, default: `now()`]

  indexes {
    (org_id, user_id) [unique, name: 'uq_org_member']
    (user_id)         [name: 'idx_members_user_id', note: '근로자의 소속 조직 목록 조회']
  }

  Note: '근로자 1명이 여러 조직에 동시 소속 가능. 시급·타입은 조직별로 독립 관리.'
}

Table fixed_schedule_patterns {
  id             bigint      [pk, increment]
  member_id      bigint      [not null, ref: > organization_members.id]
  day_of_week    day_of_week [not null]
  is_work_day    boolean     [not null, default: true]
  work_start     time        [null, note: 'is_work_day=true 시 필수']
  work_end       time        [null, note: 'is_work_day=true 시 필수']
  break_start    time        [null]
  break_end      time        [null]
  effective_from date        [not null, note: '변경 반영 시작일 (즉시/다음주/다음달/직접 입력)']
  created_at     timestamp   [not null, default: `now()`]
  updated_at     timestamp   [not null, default: `now()`]

  indexes {
    (member_id, day_of_week, effective_from) [unique,
      note: '동일 요일·적용일 중복 방지. 가장 최근 effective_from이 현재 패턴']
  }

  Note: 'FIXED 타입 멤버의 요일별 근무 패턴. 패턴 변경 시 새 effective_from으로 row 추가.'
}


// ----------------------------------------------------------------
// FR-1.3 조직 설정 — 시간대별 최소 인원 조건
// ----------------------------------------------------------------

Table min_staffing_rules {
  id           bigint    [pk, increment]
  org_id       bigint    [not null, ref: > organizations.id]
  days_bitmask int       [not null,
    note: 'bit1=월, bit2=화, bit3=수, bit4=목, bit5=금, bit6=토, bit7=일. 예: 0b0111110(62) = 월~금']
  time_start   time      [not null]
  time_end     time      [not null]
  min_count    int       [not null]
  created_at   timestamp [not null, default: `now()`]
  updated_at   timestamp [not null, default: `now()`]
}


// ----------------------------------------------------------------
// FR-2. 스케줄 관리
// ----------------------------------------------------------------

Table schedule_periods {
  id          bigint        [pk, increment]
  org_id      bigint        [not null, ref: > organizations.id]
  start_date  date          [not null]
  end_date    date          [not null]
  deadline_at timestamp     [not null, note: '근로자 신청 마감 시각']
  status      period_status [not null, default: 'OPEN']
  created_at  timestamp     [not null, default: `now()`]
  updated_at  timestamp     [not null, default: `now()`]

  Note: 'FLEXIBLE·혼용 조직의 신청 기간. 오픈 시 availability_requests 레코드 자동 생성.'
}

Table availability_requests {
  id               bigint              [pk, increment]
  period_id        bigint              [not null, ref: > schedule_periods.id]
  member_id        bigint              [not null, ref: > organization_members.id]
  date             date                [not null]
  availability     availability_status [not null, default: 'AVAILABLE']
  constraint_start time                [null, note: '이 시각 이후 근무 가능 (TIME_CONSTRAINED 시)']
  constraint_end   time                [null, note: '이 시각 이전 근무 가능 (TIME_CONSTRAINED 시)']
  created_at       timestamp           [not null, default: `now()`]
  updated_at       timestamp           [not null, default: `now()`]

  indexes {
    (period_id, member_id, date) [unique]
  }

  Note: '기간 오픈 시 AVAILABLE로 자동 생성. 근로자는 변경 필요한 날만 수정.'
}

Table schedules {
  id            bigint          [pk, increment]
  org_id        bigint          [not null, ref: > organizations.id]
  member_id     bigint          [not null, ref: > organization_members.id]
  period_id     bigint          [null,     ref: > schedule_periods.id,
    note: 'FLEXIBLE·혼용 조직은 참조. FIXED 전용 조직(월 단위 자동 생성)은 null']
  date          date            [not null]
  work_start    timestamp       [not null]
  work_end      timestamp       [not null, note: '자정 넘기는 야간 근무도 timestamp로 표현']
  schedule_type schedule_type   [not null]
  status        schedule_status [not null, default: 'DRAFT']
  created_at    timestamp       [not null, default: `now()`]
  updated_at    timestamp       [not null, default: `now()`]

  indexes {
    (member_id, date)        [name: 'idx_schedules_member_date',  note: '근로자별 스케줄 캘린더 조회']
    (org_id, date, status)   [name: 'idx_schedules_org_date_status', note: '관리자 스케줄 목록·AI 추천 조회']
  }

  Note: 'FIXED는 fixed_schedule_patterns 기반 자동 생성(즉시 PUBLISHED). FLEXIBLE은 AI 추천 후 관리자 확정.'
}

Table schedule_exchange_requests {
  id                    bigint          [pk, increment]
  requester_schedule_id bigint          [not null, ref: > schedules.id, note: '교환 신청자 A의 스케줄']
  target_schedule_id    bigint          [not null, ref: > schedules.id, note: '교환 대상자 B의 스케줄']
  status                exchange_status [not null, default: 'PENDING_ACCEPTANCE']
  reject_reason         varchar(500)    [null]
  expires_at            timestamp       [not null,
    note: '기본 24h. 근무일까지 24h 미만이면 근무일까지 남은 시간으로 자동 단축']
  approved_by           bigint          [null, ref: > users.id, note: '최종 승인한 관리자']
  created_at            timestamp       [not null, default: `now()`]
  updated_at            timestamp       [not null, default: `now()`]

  Note: '동일 조직 내에서만 허용. organizations.allow_schedule_exchange=true 시 활성화.'
}


// ----------------------------------------------------------------
// FR-3. 근태 관리
// ----------------------------------------------------------------

Table attendances {
  id              bigint            [pk, increment]
  schedule_id     bigint            [unique, not null, ref: - schedules.id,
    note: '스케줄 1개 → 근태 레코드 1개 (1:1). PUBLISHED 시 EXPECTED 상태로 자동 생성']
  member_id       bigint            [not null, ref: > organization_members.id]
  status          attendance_status [not null, default: 'EXPECTED']
  checkin_at      timestamp         [null]
  checkin_lat     decimal(10,7)     [null, note: 'GPS 출근 체크 시 기록']
  checkin_lng     decimal(10,7)     [null]
  checkout_at     timestamp         [null]
  is_overtime     boolean           [not null, default: false]
  overtime_end_at timestamp         [null, note: '연장 근무 선택 시 실제 업무 종료 시각']
  is_late         boolean           [not null, default: false,
    note: 'checkin_at > schedule.work_start 이면 true. 서버에서 자동 판정']
  signed          boolean           [not null, default: false]
  signed_at       timestamp         [null, note: '근로자 서명 즉시 FR-4 급여 계산 트리거']
  created_at      timestamp         [not null, default: `now()`]
  updated_at      timestamp         [not null, default: `now()`]

  indexes {
    (member_id, status) [name: 'idx_attendances_member_status',
      note: '미처리 근태 알림·급여 계산 대상 조회 (COMPLETED 필터)']
  }
}

Table attendance_adjustment_requests {
  id             bigint                    [pk, increment]
  attendance_id  bigint                    [not null, ref: > attendances.id]
  requester_id   bigint                    [not null, ref: > users.id, note: '근로자']
  adjust_type    adjust_type               [not null]
  requested_time timestamp                 [not null]
  reason         text                      [null]
  status         adjustment_request_status [not null, default: 'PENDING']
  reviewed_by    bigint                    [null, ref: > users.id, note: '승인/거절한 관리자']
  reviewed_at    timestamp                 [null]
  created_at     timestamp                 [not null, default: `now()`]
  updated_at     timestamp                 [not null, default: `now()`]

  indexes {
    (attendance_id, status) [name: 'idx_adj_req_attendance_status',
      note: '관리자 검토 대기 목록 조회 (PENDING 필터)']
  }

  Note: '동일 날짜 중복 요청 불가. 급여 계산 완료 근태는 요청 차단.'
}

Table attendance_audit_logs {
  id            bigint                  [pk, increment]
  attendance_id bigint                  [not null, ref: > attendances.id]
  action        attendance_audit_action [not null]
  actor_id      bigint                  [not null, ref: > users.id, note: '처리한 관리자']
  note          text                    [null]
  created_at    timestamp               [not null, default: `now()`]

  Note: '불변 감사 로그 — updated_at 없음. 관리자 직접 입력(FR-3.5) 및 근태 수정 요청 승인/거절(FR-3.4) 기록.'
}


// ----------------------------------------------------------------
// FR-4. 급여 계산 엔진
// ----------------------------------------------------------------

Table payroll_records {
  id                     bigint         [pk, increment]
  member_id              bigint         [not null, ref: > organization_members.id]
  period_id              bigint         [null,     ref: > schedule_periods.id,
    note: 'FLEXIBLE·혼용 조직은 참조. FIXED 전용은 null']
  period_start           date           [not null]
  period_end             date           [not null]
  wage_template_snapshot json           [not null,
    note: '계산 시점 템플릿 스냅샷. 이후 템플릿 변경에도 계산 근거 보존 (FR-4.4)']
  status                 payroll_status [not null, default: 'CALCULATED']
  base_pay               decimal(12,2)  [not null, default: 0]
  weekly_holiday_pay     decimal(12,2)  [not null, default: 0]
  overtime_pay           decimal(12,2)  [not null, default: 0]
  night_shift_pay        decimal(12,2)  [not null, default: 0]
  holiday_pay            decimal(12,2)  [not null, default: 0]
  bonus                  decimal(12,2)  [not null, default: 0]
  non_taxable            decimal(12,2)  [not null, default: 0]
  deduction_amount       decimal(12,2)  [not null, default: 0]
  net_pay                decimal(12,2)  [not null, default: 0]
  issued_at              timestamp      [null]
  created_at             timestamp      [not null, default: `now()`]
  updated_at             timestamp      [not null, default: `now()`]

  indexes {
    (member_id, period_start, period_end) [name: 'idx_payroll_member_period',
      note: '근로자 급여 명세서 조회·기간 중복 방지']
  }

  Note: '근로자 서명(attendances.signed=true) 시 자동 생성. 3년 보존.'
}

// [N:M] payroll_records ↔ attendances 중간 테이블
// 어느 근태가 이번 급여에 포함/제외됐는지 DB 레벨에서 추적
Table payroll_attendance_items {
  id                bigint                       [pk, increment]
  payroll_record_id bigint                       [not null, ref: > payroll_records.id]
  attendance_id     bigint                       [not null, ref: > attendances.id]
  inclusion         payroll_attendance_inclusion  [not null,
    note: 'EXCLUDED = UNPROCESSED 등으로 제외된 항목. 명세서에 "미처리로 제외" 표시 (FR-4.1)']
  created_at        timestamp                    [not null, default: `now()`]

  indexes {
    (payroll_record_id, attendance_id) [unique, name: 'uq_payroll_attendance']
  }

  Note: '급여 계산 시 포함·제외된 근태 항목을 명시적으로 연결. 분쟁 발생 시 근거 자료.'
}

Table payroll_audit_logs {
  id                bigint         [pk, increment]
  payroll_record_id bigint         [not null, ref: > payroll_records.id]
  action            payroll_action [not null]
  triggered_by      bigint         [null, ref: > users.id,
    note: 'null = 근로자 서명으로 자동 트리거 / 값 있음 = 관리자 수동 재계산']
  note              text           [null]
  created_at        timestamp      [not null, default: `now()`]

  Note: '불변 감사 로그 — updated_at 없음. 계산 실행마다 기록. 근태 수정 후 재계산 이력 별도 구분. 3년 보존.'
}
