{
  "name": "@fragment/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "node --watch -r ts-node/register src/main.ts",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fragment/database": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "eslint": "^9",
    "typescript-eslint": "^8",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5"
  }
}
