{
  "name": "@fragment/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "pnpm --filter @fragment/shared build && node --watch -r ts-node/register src/main.ts",
    "dev": "pnpm --filter @fragment/shared build && node --watch -r ts-node/register src/main.ts",
    "build": "pnpm --filter @fragment/shared build && tsc -p tsconfig.build.json",
    "start": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "pnpm --filter @fragment/shared build && tsc --noEmit"
  },
  "dependencies": {
    "@fragment/database": "workspace:*",
    "@fragment/shared": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "eslint": "^9",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
